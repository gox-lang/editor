{
  "$schema": "vscode://schemas/color-theme",
  "name": "GOX Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#11161C",
    "editor.foreground": "#D5DCE5",
    "editorLineNumber.foreground": "#46515E",
    "editorLineNumber.activeForeground": "#91A0B2",
    "editorCursor.foreground": "#00ADD8",
    "editor.selectionBackground": "#29445A99",
    "editor.inactiveSelectionBackground": "#26374666",
    "editor.lineHighlightBackground": "#182028",
    "editorIndentGuide.background1": "#26313C",
    "editorIndentGuide.activeBackground1": "#465665",
    "editorWhitespace.foreground": "#303B47",
    "editorBracketMatch.background": "#33415566",
    "editorBracketMatch.border": "#00ADD888",
    "editorBracketHighlight.foreground1": "#00ADD8",
    "editorBracketHighlight.foreground2": "#00ADD8",
    "editorBracketHighlight.foreground3": "#00ADD8",
    "editorBracketHighlight.foreground4": "#00ADD8",
    "editorBracketHighlight.foreground5": "#00ADD8",
    "editorBracketHighlight.foreground6": "#00ADD8",
    "editorBracketHighlight.unexpectedBracket.foreground": "#00ADD8",
    "editorInlayHint.typeForeground": "#FF4FA3",
    "editorInlayHint.typeBackground": "#00000000",
    "editorInlayHint.parameterForeground": "#708090B3",
    "editorInlayHint.parameterBackground": "#00000000",
    "editorGutter.background": "#11161C",
    "sideBar.background": "#0D1217",
    "sideBar.foreground": "#B8C2CE",
    "activityBar.background": "#090D11",
    "activityBar.foreground": "#D5DCE5",
    "activityBar.inactiveForeground": "#647180",
    "statusBar.background": "#18242E",
    "statusBar.foreground": "#D5DCE5",
    "titleBar.activeBackground": "#0D1217",
    "titleBar.activeForeground": "#D5DCE5",
    "tab.activeBackground": "#11161C",
    "tab.inactiveBackground": "#0D1217",
    "tab.activeForeground": "#E7EDF4",
    "tab.inactiveForeground": "#758292",
    "panel.background": "#0D1217",
    "terminal.background": "#0D1217",
    "terminal.foreground": "#D5DCE5"
  },
  "semanticTokenColors": {
    "namespace:gox": "#5DC9E2",
    "type:gox": "#5DC9E2",
    "struct:gox": "#5DC9E2",
    "interface:gox": "#5DC9E2",
    "parameter:gox": "#D5DCE5",
    "variable:gox": "#D5DCE5",
    "property:gox": "#3EAD99",
    "enumMember:gox": "#F78C6C",
    "function:gox": "#E7C86E",
    "method:gox": "#E7C86E",
    "label:gox": "#F78C6C",
    "comment:gox": {
      "foreground": "#677789"
    },
    "string:gox": "#A8D08D",
    "number:gox": "#F78C6C",
    "operator:gox": "#72C7DA",
    "keyword:gox": "#00ADD8",
    "goxModuleKeyword:gox": {
      "foreground": "#00ADD8",
      "fontStyle": "bold"
    },
    "goxClientKeyword:gox": {
      "foreground": "#00ADD8"
    },
    "goxClientFramework:gox": "#5DC9E2",
    "goxTag:gox": "#FF4FA3",
    "goxAttribute:gox": "#3EAD99",
    "goxAttributeValue:gox": "#D98E5F",
    "goxDirective:gox": {
      "foreground": "#00ADD8",
      "fontStyle": "bold"
    },
    "goxComponent:gox": {
      "foreground": "#E7C86E",
      "fontStyle": "bold"
    },
    "goxClient:gox": {
      "foreground": "#FFB86C",
      "fontStyle": "bold"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#677789"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#00ADD8"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character"
      ],
      "settings": {
        "foreground": "#A8D08D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#E7C86E"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "storage.type.string"
      ],
      "settings": {
        "foreground": "#5DC9E2"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#72C7DA"
      }
    },
    {
      "scope": [
        "punctuation.definition.begin.bracket.curly.go",
        "punctuation.definition.end.bracket.curly.go"
      ],
      "settings": {
        "foreground": "#72C7DA"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#D5DCE5"
      }
    },
    {
      "scope": "keyword.control.module.gox",
      "settings": {
        "foreground": "#00ADD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "entity.name.namespace.gox",
      "settings": {
        "foreground": "#5DC9E2"
      }
    },
    {
      "scope": "storage.type.client.gox",
      "settings": {
        "foreground": "#00ADD8"
      }
    },
    {
      "scope": "entity.name.type.client.gox",
      "settings": {
        "foreground": "#FFB86C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "support.constant.framework.gox",
      "settings": {
        "foreground": "#5DC9E2"
      }
    },
    {
      "scope": "entity.name.tag.html",
      "settings": {
        "foreground": "#FF4FA3"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.definition.tag.fragment.begin.gox",
        "punctuation.definition.tag.fragment.end.gox",
        "punctuation.definition.tag.fragment.gox"
      ],
      "settings": {
        "foreground": "#8292A2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.special.gox"
      ],
      "settings": {
        "foreground": "#3EAD99"
      }
    },
    {
      "scope": "entity.other.attribute-name.directive.gox",
      "settings": {
        "foreground": "#00ADD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html",
        "meta.tag.html.gox string",
        "meta.tag.directive.gox string",
        "meta.tag.component.gox string",
        "meta.tag.client.gox string"
      ],
      "settings": {
        "foreground": "#D98E5F"
      }
    },
    {
      "scope": [
        "punctuation.definition.string.begin.html",
        "punctuation.definition.string.end.html",
        "meta.tag.html.gox constant.character.entity.html",
        "meta.tag.directive.gox constant.character.entity.html",
        "meta.tag.component.gox constant.character.entity.html",
        "meta.tag.client.gox constant.character.entity.html"
      ],
      "settings": {
        "foreground": "#D98E5F"
      }
    },
    {
      "scope": "punctuation.separator.key-value.attribute.gox",
      "settings": {
        "foreground": "#708090"
      }
    },
    {
      "scope": "text.html.gox",
      "settings": {
        "foreground": "#C9D2DC"
      }
    },
    {
      "scope": "constant.character.entity.html",
      "settings": {
        "foreground": "#D98E5F"
      }
    },
    {
      "scope": [
        "comment.block.html.gox",
        "punctuation.definition.comment.html.gox"
      ],
      "settings": {
        "foreground": "#677789"
      }
    },
    {
      "scope": [
        "entity.name.tag.directive.gox",
        "punctuation.definition.tag.directive.gox"
      ],
      "settings": {
        "foreground": "#00ADD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag.component.gox",
        "punctuation.definition.tag.component.gox"
      ],
      "settings": {
        "foreground": "#E7C86E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag.client.gox",
        "punctuation.definition.tag.client.gox"
      ],
      "settings": {
        "foreground": "#FFB86C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.gox",
        "punctuation.section.embedded.end.gox"
      ],
      "settings": {
        "foreground": "#00ADD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.embedded.expression.gox string",
      "settings": {
        "foreground": "#A8D08D"
      }
    },
    {
      "scope": "punctuation.separator.key-value.gox",
      "settings": {
        "foreground": "#60758A"
      }
    },
    {
      "scope": [
        "entity.name.tag.js.jsx",
        "entity.name.tag.tsx",
        "entity.name.tag.localname.js.jsx",
        "entity.name.tag.localname.tsx",
        "support.class.component.js",
        "support.class.component.tsx"
      ],
      "settings": {
        "foreground": "#FF4FA3"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.js.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.jsx"
      ],
      "settings": {
        "foreground": "#3EAD99"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag.begin.js.jsx",
        "punctuation.definition.tag.end.js.jsx",
        "punctuation.definition.tag.begin.tsx",
        "punctuation.definition.tag.end.tsx"
      ],
      "settings": {
        "foreground": "#8292A2"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.js.jsx",
        "punctuation.section.embedded.end.js.jsx",
        "punctuation.section.embedded.begin.tsx",
        "punctuation.section.embedded.end.tsx"
      ],
      "settings": {
        "foreground": "#72C7DA"
      }
    },
    {
      "scope": [
        "variable.other.property.js",
        "variable.other.property.ts",
        "variable.other.object.property.js",
        "variable.other.object.property.ts",
        "meta.object-literal.key.js",
        "meta.object-literal.key.ts"
      ],
      "settings": {
        "foreground": "#3EAD99"
      }
    },
    {
      "scope": [
        "entity.name.type.class.js",
        "entity.name.type.class.ts",
        "entity.name.type.interface.ts",
        "entity.name.type.enum.ts"
      ],
      "settings": {
        "foreground": "#5DC9E2"
      }
    },
    {
      "scope": [
        "entity.name.tag.vue",
        "entity.name.tag.svelte",
        "entity.name.tag.html.vue",
        "entity.name.tag.html.svelte",
        "entity.name.tag.block.any.html",
        "entity.name.tag.script.html",
        "entity.name.tag.template.html",
        "entity.name.tag.style.html"
      ],
      "settings": {
        "foreground": "#FF4FA3"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag.vue",
        "punctuation.definition.tag.svelte",
        "punctuation.definition.tag.begin.vue",
        "punctuation.definition.tag.end.vue",
        "punctuation.definition.tag.begin.svelte",
        "punctuation.definition.tag.end.svelte"
      ],
      "settings": {
        "foreground": "#8292A2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.vue",
        "entity.other.attribute-name.svelte",
        "entity.other.attribute-name.html.vue",
        "entity.other.attribute-name.html.svelte"
      ],
      "settings": {
        "foreground": "#3EAD99"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.directive.vue",
        "entity.other.attribute-name.directive.svelte",
        "keyword.control.directive.vue",
        "keyword.control.svelte",
        "support.function.directive.vue"
      ],
      "settings": {
        "foreground": "#00ADD8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.vue",
        "punctuation.section.embedded.end.vue",
        "punctuation.section.embedded.begin.svelte",
        "punctuation.section.embedded.end.svelte",
        "punctuation.definition.block.svelte"
      ],
      "settings": {
        "foreground": "#72C7DA"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#FF4FA3"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#3EAD99"
      }
    },
    {
      "scope": [
        "support.function.misc.css",
        "support.function.transform.css",
        "support.function.var.css"
      ],
      "settings": {
        "foreground": "#E7C86E"
      }
    },
    {
      "scope": [
        "constant.numeric.css",
        "keyword.other.unit.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#F78C6C"
      }
    },
    {
      "scope": [
        "variable.css",
        "variable.other.custom-property.css"
      ],
      "settings": {
        "foreground": "#5DC9E2"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#FF6B81",
        "fontStyle": "underline"
      }
    }
  ]
}
